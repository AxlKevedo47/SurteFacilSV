<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:padding="12dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="?attr/colorSurface">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

                <!-- Imagen del producto -->
                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_image_placeholder" />

                <!-- Nombre -->
                <TextView
                    android:id="@+id/txtProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/imgProduct"
                    android:layout_marginStart="16dp"
                    android:layout_alignTop="@id/imgProduct"
                    android:text="Nombre del Producto"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface" />

                <!-- Precio -->
                <TextView
                    android:id="@+id/txtProductPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txtProductName"
                    android:layout_toEndOf="@id/imgProduct"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"
                    android:text="$0.00"
                    android:textSize="15sp"
                    android:textColor="?attr/colorPrimary" />

                <!-- Edit Icon (color fijo) -->
                <ImageView
                    android:id="@+id/btnEditProduct"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignTop="@id/imgProduct"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="66dp"
                    android:contentDescription="Editar"
                    android:src="@drawable/ic_edit"
                    app:tint="#4CAF50" /> <!-- Color fijo: naranja -->

                <!-- Delete Icon (color fijo) -->
                <ImageView
                    android:id="@+id/btnDeleteProduct"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignTop="@id/btnEditProduct"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="Eliminar"
                    android:src="@drawable/ic_trash_can"
                    app:tint="#B6342C" /> <!-- Color fijo: rojo -->

        </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
